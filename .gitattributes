# Text files are stored with LF line endings in the repository; Git converts them on checkout where needed
* text=auto

# These run inside the Linux container and break with Windows line endings (CRLF), even when edited on Windows
*.sh text eol=lf
Dockerfile text eol=lf
docker/* text eol=lf

# Bundled third-party icon font: left out of GitHub's language statistics
less/icons/** linguist-vendored
